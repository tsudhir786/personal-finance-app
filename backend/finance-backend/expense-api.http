### Get all expenses
GET http://localhost:8080/api/expenses


### Get expense by ID
GET http://localhost:8080/api/expenses/15


### Create valid expense
POST http://localhost:8080/api/expenses
Content-Type: application/json

{
  "description": "Groceries",
  "amount": 850.00
}


### Create invalid expense
POST http://localhost:8080/api/expenses
Content-Type: application/json

{
  "description": "",
  "amount": -100
}


### Update existing expense
PUT http://localhost:8080/api/expenses/6
Content-Type: application/json

{
  "description": "Updated Petrol",
  "amount": 1600.00
}


### Update missing expense
PUT http://localhost:8080/api/expenses/9999
Content-Type: application/json

{
  "description": "Updated Petrol",
  "amount": 1600.00
}


### Update with invalid body
PUT http://localhost:8080/api/expenses/6
Content-Type: application/json

{
  "description": "",
  "amount": -100
}


### Delete existing expense
DELETE http://localhost:8080/api/expenses/15


### Delete missing expense
DELETE http://localhost:8080/api/expenses/9999

### Create valid expense
POST http://localhost:8080/api/expenses
Content-Type: application/json

{
  "description": "Car EMI",
  "amount": 10004.00,
  "unknownField": "extra value"
}


### Update existing expense using DTO
PUT http://localhost:8080/api/expenses/11
Content-Type: application/json

{
  "description": "Updated Mobile Recharge",
  "amount": 899.00
}

### Update expense with invalid DTO
PUT http://localhost:8080/api/expenses/11
Content-Type: application/json

{
  "description": "",
  "amount": -100
}

### Update missing expense using DTO
PUT http://localhost:8080/api/expenses/9999
Content-Type: application/json

{
  "description": "Unknown Expense",
  "amount": 500.00
}